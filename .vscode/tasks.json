{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "build.bat",
      "args": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "gcc",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?)(\\((\\d+)(,\\d+)?\\))?:\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 3,
          "severity": 5,
          "message": 6
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "make",
      "type": "shell",
      "command": "make",
      "args": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": {
        "owner": "gcc",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?)(\\((\\d+)(,\\d+)?\\))?:\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 3,
          "severity": 5,
          "message": 6
        }
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make",
      "args": [
        "clean"
      ],
      "problemMatcher": []
    },
    {
      "label": "run demo",
      "type": "shell",
      "command": ".\\bin\\sort_demo.exe",
      "args": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "run tests",
      "type": "shell",
      "command": ".\\bin\\sort_test.exe",
      "args": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
